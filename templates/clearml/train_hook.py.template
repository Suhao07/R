"""Optional rank-zero training hook for a responsibility repository.

Copy beside ``clearml_adapter.py`` and call the two small functions from the
existing train entrypoint.  The trainer, optimizer, DeepSpeed launcher and
TensorBoard logger remain authoritative; this hook only mirrors finite values
to ClearML when the process is rank zero.
"""

from __future__ import annotations

from pathlib import Path
from typing import Any, Mapping, Sequence

from clearml_adapter import (ClearMLRun, build_run_configuration, load_profile)


def start_training_observer(
    *,
    profile_path: Path,
    run_id: str,
    repo_root: Path | None = None,
    command: Sequence[str] | str | None = None,
    experiment_record: Path | None = None,
    receipt: Path | None = None,
    data_fingerprint: str | None = None,
    model_fingerprint: str | None = None,
    validation_scope: str | None = None,
    description: str | None = None,
) -> ClearMLRun:
    """Create the one Task used by all ranks of a distributed train run."""

    profile = load_profile(profile_path)
    run = ClearMLRun(profile, run_id=run_id, task_kind='train')
    run.start(
        build_run_configuration(
            run_id=run_id,
            repo_root=repo_root,
            command=command,
            experiment_record=experiment_record,
            receipt=receipt,
            data_fingerprint=data_fingerprint,
            model_fingerprint=model_fingerprint,
            validation_scope=validation_scope,
        ),
        description=description,
    )
    return run


def report_training_step(run: ClearMLRun, *, iteration: int,
                         values: Mapping[str, Any]) -> None:
    """Mirror a finite training-step mapping through profile metric names."""

    for logical_name, value in values.items():
        mapping = run.profile.get('metrics', {}).get('train', {})
        target = mapping.get(logical_name) if isinstance(mapping,
                                                         Mapping) else None
        if not isinstance(target, str) or not target:
            continue
        title, separator, series = target.partition('/')
        if not separator:
            title, series = 'train', title
        run.report_scalar(title, series, value, iteration=iteration)


def report_training_checkpoint(run: ClearMLRun, *, step: int,
                               checkpoint_path: Path) -> None:
    """Record one project-owned checkpoint using the profile upload policy."""

    run.record_checkpoint(checkpoint_path, step=step)


def finish_training_observer(run: ClearMLRun, *, success: bool) -> None:
    """Mark the Task terminal state without changing the canonical receipt."""

    run.finalize(success=success)
